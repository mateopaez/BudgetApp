# Firebase web app config — set these in the Vercel dashboard (mark as Sensitive).
# Local dev: run `vercel env pull .env.local` then `npm start`.
# Vercel injects these automatically at build time for deployments.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
